# Steps to Upload a Project on GitHub

# Step 1: Create a README.md file (optional)
echo "# Yash-Mandloi" >> README.md

# Step 2: Initialize a Git repository (only Onces in the project when its initialized)
git init

# Step 3: Add files to the staging area
git add .

# Step 4: Commit the changes
git commit -m "Added initial project files"

# Step 5: Rename the branch to main (only if not already done)
git branch -M main

# Step 6: Add the remote repository URL (only if not already added)
git remote add origin https://github.com/Yashmandloi1411/Yash-Mandloi.git

# Step 7: Push the changes to GitHub
git push -u origin main




